{
  "name": "ultraclaude-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codex plugin for structured, read-only Claude Code second opinions.",
  "workspaces": [
    "plugins/ultraclaude"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "preflight": "node plugins/ultraclaude/skills/claude-workflow/scripts/claude-node.mjs preflight --pretty",
    "dry-run": "node plugins/ultraclaude/skills/claude-workflow/scripts/claude-node.mjs dry-run --request tests/fixtures/request.json --pretty",
    "pack:check": "npm pack --workspace ultraclaude --dry-run --json"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0"
}
